 void primeRange(int n1 ,int n2 ){
         int i,j;
         for(i=n1;i<=n2;i++)
         {
                 for(j=2;j<i;j++)
                 {
                         if(!(i%j))
                                 break;
                 }
                 if(i==j)
                         printf("prime number%d\n",i);
                 // print prime number
         }
 }
 int primeCount(int *p ,int *q){
         int c=0,i,j;
          int n1=*p,n2=*q;
         for(i=n1;i<n2;i++)
         {
                 for(j=2;j<i;j++)
                 {
                         if(!(i%j))
                                 break;
                 }
                 if(i==j)
                         c++;
         }
 return c;
 }
 
 int Check_Perfect (int *p )
 {
         int i,add=0;
         for(i=1;i<*p;i++)
         {
                 if(!(*p%i))
                         add+=i;
         }
         if(*p==add)
                 return 1;
         else
                 return 0;
 }

 int Check_Palindrome(int *p)
 {
         int rev,r,temp;
         temp=*p;
         rev=0;
         while(temp)
         {
                 r=temp%10;
                 rev=rev*10+r;
                 temp=temp/10;
         }
         if(*p==rev)
                 return 1;
         else
                 return 0;
 }

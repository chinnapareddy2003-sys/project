 int Check_Strong(int *p)
 {
         int i,temp,r,sum,fact;
         temp=*p;
         sum=0;
         while(temp>0)
         {
                 r=temp%10;
                 fact=1;
                 for(i=1;i<=r;i++)
                 {
                         fact=fact*i;
                 }
                 sum=sum+fact;
                 temp=temp/10;
         }
         if(sum==*p)
                 return 1;
         else
                 return 0;
 }

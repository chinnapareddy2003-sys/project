 //Prime Function
 //----------------->
 int Check_Prime (int *p )
 {
         int i;
         for(i=2;i<*p;i++)
         {
                 if(!(*p%i))
                         break;
         }
         if(*p==i)
                 return 1;
         else
                 return 0;
 
         // return 1 if prime
         // return 0 otherwise
 }
